<Project Sdk="Microsoft.NET.Sdk">

  <!--
    External region store (ARCHITECTURE.md §3, Contracts/README.md "Region store layout").
    Engine side only: net8.0 because it needs System.Text.Json and a schema validator, neither of which is
    verified to load inside CS2 (V-03). The in-game exporter does not use this library: it only creates
    inbox files. Revisit the target framework if V-03 is verified and the mod needs to read the store.
    No game references. Never touches .cok or other save files.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Regions.Store</RootNamespace>
    <AssemblyName>Regions.RegionStore</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pinned version as the test projects. -->
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\RegionalEngine\RegionalEngine.csproj" />
  </ItemGroup>

</Project>
